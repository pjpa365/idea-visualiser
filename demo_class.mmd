classDiagram
    class Connection {
        +String host
        +int port
        +connect()
        +disconnect()
    }
    class Message {
        +int id
        +bytes payload
        +checksum() int
    }
    class Session {
        +start()
        +stop()
    }
    Session "1" --> "1" Connection : uses
    Session "1" --> "*" Message : sends
